# PayPal sandbox app: developer.paypal.com > Apps & Credentials > Sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional: webhook id from the same app, enables signature verification
PAYPAL_WEBHOOK_ID=
# Local testing only: process unsigned webhooks. Ignored when PayPal keys are set.
ALLOW_UNVERIFIED_WEBHOOKS=0

# AI for the agents. Pick ONE (all optional; with none, the built-in demo brain drives the agents).
# Free: Google Gemini key from https://aistudio.google.com (Get API key), no card needed
GEMINI_API_KEY=
# Free: Groq key from https://console.groq.com/keys
GROQ_API_KEY=
# Paid: Anthropic Claude key from https://console.anthropic.com
ANTHROPIC_API_KEY=
# Force a provider (gemini | groq | ollama | anthropic) and/or model. Leave blank to auto-pick from the keys above.
# For a fully local, keyless model: install Ollama, run `ollama pull qwen2.5:7b`, then set LLM_PROVIDER=ollama
LLM_PROVIDER=
LLM_MODEL=

# Optional sponsor integrations
ELASTIC_URL=
ELASTIC_API_KEY=
ELASTIC_INDEX=sentinel-twin-events
ZAPIER_WEBHOOK_URL=

# Twin settings
AUTO_TRAFFIC=1
GAT_EPOCHS=120
TWIN_SEED=3

# Channel3 live product search for the shopping agent (optional; demo catalog without it)
CHANNEL3_API_KEY=
