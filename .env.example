# PayPal sandbox app: developer.paypal.com > Apps & Credentials > Sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional: webhook id from the same app, enables signature verification
PAYPAL_WEBHOOK_ID=

# Claude (Anthropic API). Without it the agents run on the deterministic demo brain.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low

# Optional sponsor integrations
ELASTIC_URL=
ELASTIC_API_KEY=
ELASTIC_INDEX=sentinel-twin-events
ZAPIER_WEBHOOK_URL=

# Twin settings
AUTO_TRAFFIC=1
GAT_EPOCHS=120
TWIN_SEED=3
